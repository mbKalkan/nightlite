{
  "name": "nightlite",
  "displayName": "%displayName%",
  "description": "%description%",
  "icon": "assets/icon.png",
  "version": "0.1.0",
  "publisher": "MBKDevStudio",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightlite.git"
  },
  "homepage": "https://github.com/mbKalkan/nightlite#readme",
  "bugs": {
    "url": "https://github.com/mbKalkan/nightlite/issues"
  },
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "sqlite",
    "sqlite3",
    "db3",
    "sqlite viewer",
    "sqlite browser",
    "sqlite explorer",
    "database",
    "database viewer",
    "db viewer",
    "db",
    "sql",
    "schema",
    "table viewer",
    "mbtiles",
    "mbtiles viewer",
    "map tiles",
    "vector tiles",
    "mvt",
    "geopackage",
    "gpkg",
    "gis",
    "maps",
    "viewer",
    "read-only",
    "large files",
    "dark mode",
    "dark theme"
  ],
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#16212b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtualWorkspaces.description%"
    }
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sqlite-database",
        "aliases": [
          "SQLite Database"
        ],
        "extensions": [
          ".sqlite",
          ".sqlite3",
          ".db3",
          ".db"
        ]
      },
      {
        "id": "mbtiles",
        "aliases": [
          "MBTiles"
        ],
        "extensions": [
          ".mbtiles"
        ]
      },
      {
        "id": "geopackage",
        "aliases": [
          "GeoPackage"
        ],
        "extensions": [
          ".gpkg"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "nightlite.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.mbtiles"
          },
          {
            "filenamePattern": "*.gpkg"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "nightlite.goToTable",
        "title": "%command.goToTable%",
        "category": "%category%"
      },
      {
        "command": "nightlite.openQuery",
        "title": "%command.openQuery%",
        "category": "%category%"
      },
      {
        "command": "nightlite.copy",
        "title": "%command.copy%",
        "category": "%category%"
      },
      {
        "command": "nightlite.copyAsMarkdown",
        "title": "%command.copyAsMarkdown%",
        "category": "%category%"
      },
      {
        "command": "nightlite.sortAscending",
        "title": "%command.sortAscending%",
        "category": "%category%"
      },
      {
        "command": "nightlite.sortDescending",
        "title": "%command.sortDescending%",
        "category": "%category%"
      },
      {
        "command": "nightlite.clearSort",
        "title": "%command.clearSort%",
        "category": "%category%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nightlite.goToTable",
          "when": "activeCustomEditorId == nightlite.viewer"
        },
        {
          "command": "nightlite.openQuery",
          "when": "activeCustomEditorId == nightlite.viewer"
        },
        {
          "command": "nightlite.copy",
          "when": "false"
        },
        {
          "command": "nightlite.copyAsMarkdown",
          "when": "activeCustomEditorId == nightlite.viewer"
        },
        {
          "command": "nightlite.sortAscending",
          "when": "activeCustomEditorId == nightlite.viewer"
        },
        {
          "command": "nightlite.sortDescending",
          "when": "activeCustomEditorId == nightlite.viewer"
        },
        {
          "command": "nightlite.clearSort",
          "when": "activeCustomEditorId == nightlite.viewer"
        }
      ],
      "webview/context": [
        {
          "command": "nightlite.copy",
          "when": "webviewId == 'nightlite.viewer' && webviewSection == 'grid'",
          "group": "9_cutcopypaste@1"
        },
        {
          "command": "nightlite.copyAsMarkdown",
          "when": "webviewId == 'nightlite.viewer' && webviewSection == 'grid'",
          "group": "9_cutcopypaste@2"
        },
        {
          "command": "nightlite.sortAscending",
          "when": "webviewId == 'nightlite.viewer' && webviewSection == 'grid' && sortable",
          "group": "1_sort@1"
        },
        {
          "command": "nightlite.sortDescending",
          "when": "webviewId == 'nightlite.viewer' && webviewSection == 'grid' && sortable",
          "group": "1_sort@2"
        },
        {
          "command": "nightlite.clearSort",
          "when": "webviewId == 'nightlite.viewer' && webviewSection == 'grid' && sortable",
          "group": "1_sort@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "nightlite.goToTable",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == nightlite.viewer"
      }
    ]
  },
  "files": [
    "assets/icon.png",
    "dist/**",
    "l10n/**",
    "package.nls*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run --passWithNoTests",
    "test:visual": "node scripts/build.mjs && playwright test",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "fixtures:large": "node scripts/gen-fixtures.mjs --large",
    "corpus": "node scripts/fetch-corpus.mjs",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs",
    "icon": "node scripts/render-icon.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.103.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
