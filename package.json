{
  "name": "nightlite",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "MBKDevStudio",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/mbKalkan/nightlite.git"
  },
  "homepage": "https://github.com/mbKalkan/nightlite#readme",
  "bugs": {
    "url": "https://github.com/mbKalkan/nightlite/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "sqlite",
    "sqlite3",
    "db3",
    "sqlite viewer",
    "sqlite browser",
    "sqlite explorer",
    "database",
    "database viewer",
    "db viewer",
    "db",
    "sql",
    "schema",
    "table viewer",
    "mbtiles",
    "mbtiles viewer",
    "map tiles",
    "vector tiles",
    "mvt",
    "geopackage",
    "gpkg",
    "gis",
    "maps",
    "viewer",
    "read-only",
    "large files",
    "dark mode",
    "dark theme"
  ],
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#16212b",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%virtualWorkspaces.description%"
    }
  },
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "sqlite-database",
        "aliases": [
          "SQLite Database"
        ],
        "extensions": [
          ".sqlite",
          ".sqlite3",
          ".db3"
        ]
      },
      {
        "id": "mbtiles",
        "aliases": [
          "MBTiles"
        ],
        "extensions": [
          ".mbtiles"
        ]
      },
      {
        "id": "geopackage",
        "aliases": [
          "GeoPackage"
        ],
        "extensions": [
          ".gpkg"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "nightlite.viewer",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.mbtiles"
          },
          {
            "filenamePattern": "*.gpkg"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "files": [
    "dist/**",
    "l10n/**",
    "package.nls*.json",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.extension.json && tsc -p tsconfig.webview.json && tsc -p tsconfig.json",
    "lint": "eslint src scripts test",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.ts\" \"*.{json,mjs,ts}\" \".github/**/*.yml\" \".vscode/*.json\" \"l10n/*.json\"",
    "test": "vitest run --passWithNoTests",
    "test:visual": "node scripts/build.mjs && playwright test",
    "test:smoke": "node scripts/build.mjs && node scripts/smoke.mjs",
    "fixtures": "node scripts/gen-fixtures.mjs",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
